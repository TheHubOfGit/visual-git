{
  "name": "visual-git",
  "version": "0.1.0",
  "description": "Visualize real local Git repositories from their .git data.",
  "type": "module",
  "bin": {
    "visualgit": "bin/visualgit.mjs"
  },
  "files": [
    "bin",
    "build",
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"tsx watch server/index.ts\" \"vite --host 127.0.0.1\"",
    "dev:web": "vite --host 127.0.0.1",
    "server": "tsx server/index.ts",
    "start": "node bin/visualgit.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsc -p tsconfig.json && vite build && node scripts/bundle-server.mjs",
    "prepare": "vite build && node scripts/bundle-server.mjs",
    "release": "npm run build && node scripts/build-release.mjs",
    "preview": "vite preview --host 127.0.0.1"
  },
  "keywords": [
    "git",
    "visualization",
    "d3"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "esbuild": "^0.28.0",
    "express": "^5.2.1",
    "tsx": "^4.21.0",
    "zod": "^4.1.13",
    "@fontsource/courier-prime": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans-condensed": "^5.3.0",
    "@fontsource/overpass": "^5.3.0",
    "@fontsource/overpass-mono": "^5.3.0",
    "@fontsource/spectral": "^5.3.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/express": "^5.0.6",
    "@types/node": "^25.0.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^10.0.3",
    "jsdom": "^27.3.0",
    "lucide-react": "^0.556.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "typescript": "^5.9.3",
    "vite": "^7.2.7",
    "vitest": "^4.0.15"
  }
}
